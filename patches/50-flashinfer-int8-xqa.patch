+def _int8_pth_xqa_required_workspace_size(
+    *,
+    batch_size: int,
+    num_kv_heads: int,
+    head_group_ratio: int,
+    head_dim: int,
+    q_len: int,
+    max_seq_len: int,
+    sm_count: int,
+) -> int:
+    """Exact caller-owned workspace bound for the patched PTH XQA launch.
+
+    For q>1 the patched launcher counts independent query-token blocks before
+    choosing KV sequence splits.  This keeps prompt chunks from multiplying
+    scratch by both dimensions while retaining the original MTP/decode launch
+    for the small q lengths where there is only one query-token block.
+    """
+    token_blocks_per_group = (
+        1
+        if q_len == 1
+        else cdiv(
+            q_len * head_group_ratio,
+            FLASHINFER_XQA_ROWS_PER_SPEC_BLOCK,
+        )
+    )
+    parallel_groups = batch_size * num_kv_heads * token_blocks_per_group
+    subseqs_per_group = min(
+        max(1, sm_count // parallel_groups),
+        cdiv(max_seq_len, FLASHINFER_XQA_CTA_TILE_SEQ_LEN),
+    )
+    # With one sequence split XQA writes directly to output and does not touch
+    # either the semaphore or partial-output scratch regions.
+    if subseqs_per_group == 1:
+        return FLASHINFER_XQA_SEMAPHORE_BUFFER_SIZE
+
+    valid_rows = (
+        head_group_ratio
+        if q_len == 1
+        else FLASHINFER_XQA_ROWS_PER_SPEC_BLOCK
+    )
+    warp_tile_rows = cdiv(valid_rows, 16) * 16
+    row_stats_size = (
+        cdiv(warp_tile_rows, 32)
+        * FLASHINFER_XQA_ROW_STATS_BYTES_PER_WARP_TILE
+    )
+    partial_output_size = (
+        valid_rows * head_dim * FLASHINFER_XQA_INPUT_ELEM_SIZE
+    )
+    num_subseqs = subseqs_per_group * parallel_groups
+    row_stats_end = 2 * row_stats_size * num_subseqs
+    partials_begin = cdiv(row_stats_end, partial_output_size) * partial_output_size
+    return (
+        FLASHINFER_XQA_SEMAPHORE_BUFFER_SIZE
+        + partials_begin
+        + partial_output_size * num_subseqs
+    )
+
