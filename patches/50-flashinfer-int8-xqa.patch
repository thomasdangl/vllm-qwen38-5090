+def _pth_xqa_scratch_size(
+    batch_size: int,
+    num_kv_heads: int,
+    head_group_ratio: int,
+    head_dim: int,
+    q_seq_len: int,
+    max_seq_len: int,
+    sm_count: int,
+    input_element_size: int,
+) -> int:
+    """Scratch bytes required by the patched PTH XQA split policy."""
+    token_blocks = (
+        1 if q_seq_len == 1 else (q_seq_len * head_group_ratio + 31) // 32
+    )
+    parallel_groups = batch_size * num_kv_heads * token_blocks
+    subseqs = min(
+        max(1, sm_count // parallel_groups),
+        (max_seq_len + 255) // 256,
+    )
+    if subseqs == 1:
