+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+# SPDX-FileCopyrightText: Songlin Yang, Yu Zhang
+# Recurrence from vLLM's fused_sigmoid_gating.py (FLA, MIT, 2023–2025).
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def recurrent(Q, K, V, A, B, AL, DB, S, O, Tape, Indices, Cu, Accepted, Checkpoint,
+              SS: tl.constexpr, QS: tl.constexpr, KS: tl.constexpr, VS: tl.constexpr,
+              AS: tl.constexpr, BS: tl.constexpr, MODE: tl.constexpr):
+    iv, nh = tl.program_id(0), tl.program_id(1)
+    n, hv = nh // 48, nh % 48
+    h = hv // 3
+    bos = tl.load(Cu + n).to(tl.int64)
+    length = tl.load(Cu + n + 1).to(tl.int64) - bos
+    src = tl.load(Indices + n * 4).to(tl.int64)
+    if length <= 0 or src <= 0:
+        return
+    if MODE == 2:
+        accepted = tl.load(Accepted + n)
+        cp = tl.load(Checkpoint + n)
+        if accepted < 1 or accepted > length or (accepted == 1 and cp != 1):
+            return
+    kk = tl.arange(0, 128)
+    vv = iv * 32 + tl.arange(0, 32)
+    offsets = hv * 16384 + vv[:, None] * 128 + kk[None, :]
+    state = tl.load(S + src * SS + offsets).to(tl.float32)
+    if MODE == 2:
+        length = accepted - 1
+        dst = tl.load(Indices + n * 4 + 1).to(tl.int64)
+        if cp == 1 and dst > 0:
+            tl.store(S + dst * SS + offsets, state)
+    for t in range(length):
+        if MODE == 1:
+            q = tl.load(Q + (bos + t) * QS + h * 128 + kk).to(tl.float32)
+            k = tl.load(K + (bos + t) * KS + h * 128 + kk).to(tl.float32)
+            v = tl.load(V + (bos + t) * VS + hv * 128 + vv).to(tl.float32)
+            a = tl.load(A + (bos + t) * AS + hv).to(tl.float32)
+            b = tl.load(B + (bos + t) * BS + hv).to(tl.float32)
+            tape = Tape + (n * 4 + t) * 10336
+            if iv == 0 and hv % 3 == 0:
+                tl.store(tape + h * 128 + kk, q)
+                tl.store(tape + 2048 + h * 128 + kk, k)
+            tl.store(tape + 4096 + hv * 128 + vv, v)
+            if iv == 0:
+                tl.store(tape + 10240 + hv, a)
+                tl.store(tape + 10288 + hv, b)
+        else:
+            tape = Tape + (n * 4 + t + 1) * 10336
+            k = tl.load(tape + 2048 + h * 128 + kk).to(tl.float32)
+            v = tl.load(tape + 4096 + hv * 128 + vv).to(tl.float32)
+            a = tl.load(tape + 10240 + hv).to(tl.float32)
+            b = tl.load(tape + 10288 + hv).to(tl.float32)
+        x = a + tl.load(DB + hv).to(tl.float32)
+        softplus_x = tl.where(x <= 20., tl.log(1 + tl.exp(x)), x)
+        g = -tl.exp(tl.load(AL + hv).to(tl.float32)) * softplus_x
+        beta = tl.sigmoid(b)
+        k = k * tl.rsqrt(tl.sum(k * k) + 1e-6)
+        state *= tl.exp(g)
+        v -= tl.sum(state * k[None, :], 1)
+        v *= beta
+        state += v[:, None] * k[None, :]
+        if MODE == 1:
+            q = q * tl.rsqrt(tl.sum(q * q) + 1e-6)
+            q = q * (128 ** -0.5)
+            out = tl.sum(state * q[None, :], 1)
+            tl.store(O + (bos + t) * 6144 + hv * 128 + vv, out)
+            if t == 0:
+                tl.store(S + src * SS + offsets, state)
+        else:
+            if cp == t + 2 and dst > 0:
+                tl.store(S + dst * SS + offsets, state)
+    if MODE == 2:
+        tl.store(S + src * SS + offsets, state)
+
+
+def verify(tape, **kw):
+    assert kw['inplace_final_state'] and kw['use_qk_l2norm_in_kernel']
+    q, k, v, a, b = [kw[key] for key in ('q', 'k', 'v', 'a', 'b')]
+    assert q.shape[0] == k.shape[0] == v.shape[0] == 1
+    assert q.shape[2:] == k.shape[2:] == (16, 128) and v.shape[2:] == (48, 128)
+    state, indices, cu = [kw[key] for key in ('initial_state', 'ssm_state_indices', 'cu_seqlens')]
+    n = len(cu) - 1
+    assert n <= 2 and state.dtype == torch.float32
+    out = torch.empty_like(v, memory_format=torch.contiguous_format)
+    recurrent[(4, n * 48)](q, k, v, a, b, kw['A_log'], kw['dt_bias'], state, out,
+        tape, indices, cu, kw['num_accepted_tokens'], kw['num_accepted_tokens'],
+        state.stride(0), q.stride(1), k.stride(1), v.stride(1), a.stride(0), b.stride(0),
+        MODE=1, num_warps=4, num_stages=3)
+    return out, state
+
+
+def commit(module, group):
+    tape, state = module.replay_tape, module.kv_cache[1]
+    recurrent[(4, 96)](tape, tape, tape, tape, tape, module.A_log, module.dt_bias,
+        state, tape, tape, group.indices, group.cu, group.accepted, group.checkpoint,
+        state.stride(0), 0, 0, 0, 0, 0, MODE=2, num_warps=4, num_stages=3)
+
+
+@triton.jit
+def prepare(Map, Lengths, BT, Running, Scheduled, Computed, Draft, Accepted,
+            Indices, Cu, OutAccepted, Checkpoint, STRIDE: tl.constexpr, BLOCK: tl.constexpr):
+    n = tl.program_id(0)
+    r = tl.load(Map + n)
+    length = tl.load(Lengths + n)
+    if n == 0:
+        tl.store(Cu, 0)
+    before = tl.load(Lengths) if n == 1 else 0
+    tl.store(Cu + n + 1, before + length)
+    cols = tl.arange(0, 4)
+    if r < 0 or length <= 0:
+        tl.store(Indices + n * 4 + cols, 0)
+        tl.store(OutAccepted + n, 1)
+        tl.store(Checkpoint + n, 0)
+        return
+    accepted = tl.load(Accepted + r)
+    start = tl.load(Computed + r) + tl.load(Scheduled + r) - tl.load(Draft + r)
+    aligned = ((start + accepted - 1) // BLOCK) * BLOCK
+    checkpoint = tl.where(aligned >= start, aligned - start + 1, 0)
+    src_col = tl.load(Running + r)
+    src = tl.load(BT + r * STRIDE + src_col)
+    dst = tl.load(BT + r * STRIDE + aligned // BLOCK - 1, mask=checkpoint > 0, other=0)
+    tl.store(Indices + n * 4 + cols, tl.where(cols == 0, src, tl.where(cols == 1, dst, 0)))
+    tl.store(OutAccepted + n, accepted)
+    tl.store(Checkpoint + n, checkpoint)
