+import torch
+
+from vllm.logger import init_logger
+from vllm.model_executor.layers.mamba.gdn import replay_triton as triton_replay
+
+logger = init_logger(__name__)
+LAYERS, GROUPS, GRAPHS = {}, [], {}
+NATIVE = None
+DUMMY = None
+
+
+def init_layer(self):
+    assert self.num_spec == 3 and self.tp_size == 1
+    assert self.gdn_decode_kernel == 'cuda'
+    assert self.get_state_dtype() == (torch.bfloat16, torch.float32)
+    assert not self.gqa_interleaved_layout and self.conv_kernel_size == 4
+    assert self.num_k_heads == 16 and self.num_v_heads == 48
+    assert self.head_k_dim == self.head_v_dim == 128
+    self.register_buffer('replay_tape', torch.empty((2, 4, 10336),
+                         device=self.A_log.device, dtype=torch.bfloat16), persistent=False)
+    self.replay_calls = {}
+    LAYERS[self.prefix] = self
+
+
+def forward(self, mixed_qkv, b, a, output_gate, core_attn_out, attn_metadata):
+    m = attn_metadata
+    n = m.num_spec_decodes
+    assert 1 <= n <= 2 and m.num_prefills == 0
+    sample = dict(mixed_qkv=mixed_qkv, a=a, b=b, output_gate=output_gate,
+                  A_log=self.A_log, dt_bias=self.dt_bias, norm_weight=self.norm.weight,
+                  norm_eps=self.layer_norm_epsilon)
+    indices, cu = m.spec_state_indices_tensor[:n], m.spec_query_start_loc[:n + 1]
+    accepted = m.num_accepted_tokens[:n]
+    key = (n, self.kv_cache[1].data_ptr(), *(t.data_ptr() for t in [mixed_qkv, a, b, output_gate, core_attn_out, indices, cu, accepted]),
+           mixed_qkv.stride(0), a.stride(0), b.stride(0), output_gate.stride(0))
+    call = self.replay_calls.get(key)
+    if call is None:
+        call = NATIVE.bind(1, sample, indices, cu, accepted, self.kv_cache[1],
+                           core_attn_out, self.replay_tape[:n], accepted)
+        if len(self.replay_calls) > 32:
+            self.replay_calls.clear()
+        self.replay_calls[key] = call
+    call()
+
+
+def init_metadata(self, kv_cache_spec, layer_names, device):
+    assert kv_cache_spec.num_speculative_blocks == 0 and self.num_spec == 3
+    self.replay_names = layer_names
+    self.map_cpu = torch.full((2,), -1, dtype=torch.int32, pin_memory=True)
+    self.length_cpu = torch.zeros(2, dtype=torch.int32, pin_memory=True)
+    for name, shape in [('mapping', (2,)), ('lengths', (2,)), ('indices', (2, 4)),
+                        ('cu', (3,)), ('accepted', (2,)), ('checkpoint', (2,))]:
+        setattr(self, name, torch.zeros(shape, device=device, dtype=torch.int32))
+    self.last = None
+    GROUPS.append(self)
+
+
+def update_metadata(self, meta, drafts, cm):
+    self.last = meta
+    n = meta.num_spec_decodes
+    assert n <= 2
+    self.map_cpu.fill_(-1)
+    self.length_cpu.zero_()
+    if n:
+        indices = (drafts >= 0).nonzero().flatten()
+        assert len(indices) == n
+        self.map_cpu[:n].copy_(indices)
+        self.length_cpu[:n].copy_(cm.query_start_loc_cpu.diff()[indices])
+    self.mapping.copy_(self.map_cpu, non_blocking=True)
+    self.lengths.copy_(self.length_cpu, non_blocking=True)
+    return meta
+
+
+def commit_graphs():
+    assert len(LAYERS) == 48 and sum(len(g.replay_names) for g in GROUPS) == 48
+    for g in GROUPS:
+        g.handles = [LAYERS[name] for name in g.replay_names]
+        g.calls = []
+        for handle in g.handles:
+            tape = handle.replay_tape
+            sample = dict(mixed_qkv=tape.view(8, 10336)[:, :10240],
+                          a=tape.view(8, 10336)[:, 10240:10288], b=tape.view(8, 10336)[:, 10288:],
+                          A_log=handle.A_log, dt_bias=handle.dt_bias, output_gate=DUMMY,
+                          norm_weight=handle.norm.weight, norm_eps=handle.layer_norm_epsilon)
+            g.calls.append(NATIVE.bind(2, sample, g.indices, g.cu, g.accepted,
+                                       handle.kv_cache[1], DUMMY, tape, g.checkpoint))
+    stream = torch.cuda.Stream()
+    stream.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(stream):
+        for kind in ('cuda', 'triton'):
+            def launch():
+                for group in GROUPS:
+                    for handle, call in zip(group.handles, group.calls):
+                        call() if kind == 'cuda' else triton_replay.commit(handle, group)
+            launch()
+            graph = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(graph):
+                launch()
+            GRAPHS[kind] = graph
+    torch.cuda.current_stream().wait_stream(stream)
+
+
+def commit(**kw):
+    ctx = kw['bufs'].postprocess_align
+    assert ctx is not None
+    active = [g for g in GROUPS if g.last is not None and g.last.num_spec_decodes]
+    if active:
+        assert len(active) == len(GROUPS)
+        kinds = set()
+        for g in GROUPS:
+            gids = [i for i, group in enumerate(kw['kv_cache_config'].kv_cache_groups)
+                    if group.layer_names == g.replay_names]
+            assert len(gids) == 1
+            table = kw['input_batch'].block_table[gids[0]].get_device_tensor(kw['num_reqs'])
+            kinds.add('cuda' if g.last.num_prefills == 0 else 'triton')
+            triton_replay.prepare[(2,)](g.mapping, g.lengths, table, ctx.mamba_state_idx_buf.gpu,
+                ctx.num_scheduled_tokens_buf.gpu, ctx.num_computed_tokens_buf.gpu,
+                ctx.num_draft_tokens_buf.gpu, kw['num_accepted_tokens_gpu'],
+                g.indices, g.cu, g.accepted, g.checkpoint, table.stride(0), g.kv_cache_spec.block_size)
+        assert len(kinds) == 1
+        kind = kinds.pop()
+        GRAPHS[kind].replay()
+
+
+def clear():
+    GROUPS.clear()
+    GRAPHS.clear()
+    for handle in LAYERS.values():
+        handle.replay_calls.clear()
+
+
+def initialize(worker):
+    global NATIVE, DUMMY
+    from vllm.config import CompilationMode
+    from vllm.model_executor.layers.mamba.gdn.replay_native import Native
+
+    config = worker.vllm_config
+    assert worker.parallel_config.tensor_parallel_size == worker.parallel_config.pipeline_parallel_size == 1
+    assert not worker.parallel_config.use_ubatching
+    assert config.scheduler_config.max_num_seqs == 2
+    assert config.compilation_config.mode == CompilationMode.NONE
+    assert worker.cache_config.mamba_cache_mode == 'align'
+    assert worker.cache_config.enable_prefix_caching
+    assert worker.cache_config.kv_cache_memory_bytes is None
+    assert torch.cuda.get_device_capability() == (12, 0)
+    assert len(LAYERS) == len({id(m) for m in LAYERS.values()}) == 48
+    NATIVE = Native()
+    DUMMY = torch.empty((8, 48, 128), device='cuda', dtype=torch.bfloat16)
+    logger.info('GDN state replay enabled: FP32 state, 7.57 MiB tape, no speculative state blocks.')
