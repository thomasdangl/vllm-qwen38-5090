+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import ctypes
+from pathlib import Path
+
+import torch
+
+
+class Native:
+    def __init__(self):
+        self.lib = ctypes.CDLL(str(Path(__file__).with_name('libgdn_replay.so')))
+        self.launch = self.lib.launch_gdn
+        self.launch.argtypes = ([ctypes.c_int] + [ctypes.c_void_p] * 14 +
+                                [ctypes.c_int] * 3 + [ctypes.c_int64] * 5 +
+                                [ctypes.c_float] * 2 + [ctypes.c_void_p])
+        self.launch.restype = ctypes.c_int
+
+    def bind(self, mode, sample, indices, cu, accepted, state, out, tape, checkpoint):
+        names = ['mixed_qkv', 'a', 'b', 'A_log', 'dt_bias']
+        inputs = [sample[n] for n in names] + [indices, cu, accepted, state,
+                  sample['output_gate'], sample['norm_weight'], out, tape, checkpoint]
+        assert len(inputs) == 14 and all(t.is_cuda for t in inputs)
+        assert all(t.dtype == torch.bfloat16 for t in [sample['mixed_qkv'], sample['a'], sample['b'], sample['output_gate'], out, tape])
+        assert state.dtype == sample['A_log'].dtype == torch.float32
+        assert state.shape[1:] == (48, 128, 128) and state.stride()[1:] == (16384, 128, 1)
+        assert sample['mixed_qkv'].shape[1] == 10240 and sample['A_log'].numel() == 48
+        assert all(t.dtype == torch.int32 and t.is_contiguous() for t in [indices, cu, accepted, checkpoint])
+        batch = indices.shape[0]
+        assert batch in (1, 2) and indices.shape == (batch, 4)
+        assert cu.shape == (batch + 1,) and accepted.shape == checkpoint.shape == (batch,)
+        assert out.is_contiguous() and tape.shape == (batch, 4, 10336) and tape.is_contiguous()
+        assert sample['norm_weight'].shape == (128,)
+        bias_type = {torch.float32: 0, torch.bfloat16: 1, torch.float16: 2}[sample['dt_bias'].dtype]
+        assert sample['norm_weight'].dtype in (torch.float32, torch.bfloat16)
+        args = [mode] + [t.data_ptr() for t in inputs] + [batch, bias_type, int(sample['norm_weight'].dtype == torch.bfloat16)]
+        args += [sample[n].stride(0) for n in ['mixed_qkv', 'a', 'b', 'output_gate']]
+        args += [state.stride(0), 128 ** -0.5, sample['norm_eps']]
+        device = inputs[0].device
+        def call():
+            stream = torch.cuda.current_stream(device).cuda_stream
+            error = self.launch(*args, stream)
+            if error:
+                raise RuntimeError(f'CUDA replay launch error {error}')
+        return call
