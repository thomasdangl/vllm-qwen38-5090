+def _move_parameter_to_pinned_uva(parameter: torch.nn.Parameter) -> int:
+    """Move one loaded CUDA parameter to pinned host memory.
+
+    The Parameter keeps a CUDA UVA view so existing Triton kernels, CUDA graph
+    capture, device checks, and MTP weight sharing continue to see a CUDA
+    tensor. The physical storage is page-locked system RAM.
+    """
+    if getattr(parameter, "_vllm_host_mapped_embedding", False):
+        return 0
+    if parameter.device.type != "cuda":
+        raise RuntimeError(
+            "VLLM_USE_HOST_MAPPED_EMBEDDINGS requires CUDA-loaded embedding "
+            f"weights, got {parameter.device}."
+        )
+
+    device_data = parameter.data
+    cpu_data = torch.empty_strided(
+        size=device_data.size(),
+        stride=device_data.stride(),
+        dtype=device_data.dtype,
+        layout=device_data.layout,
+        device="cpu",
+        pin_memory=True,
+    )
+    cpu_data.copy_(device_data, non_blocking=False)
+    if not cpu_data.is_pinned():
+        raise RuntimeError(
+            "Failed to allocate pinned storage for host-mapped embeddings."
+        )
+
+    accelerator_view = get_accelerator_view_from_cpu_tensor(cpu_data)
+    if accelerator_view.device.type != "cuda":
+        raise RuntimeError(
+            "Host-mapped embedding storage did not produce a CUDA UVA view."
+        )
+
+    parameter.data = accelerator_view
+    # Keep the CPU allocation alive explicitly. The CUDA view's storage also
+    # owns it, but this makes the lifetime contract unambiguous.
+    parameter._vllm_host_mapped_cpu_data = cpu_data
+    parameter._vllm_host_mapped_embedding = True
+    parameter._vllm_is_uva_offloaded = True
+    return cpu_data.numel() * cpu_data.element_size()
 
 
