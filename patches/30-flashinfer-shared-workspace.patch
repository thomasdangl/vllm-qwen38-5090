+def _get_shared_workspace_buffer(
+    device: torch.device | str,
+    native_workspace_size: int = 0,
+    xqa_min_workspace_size: int = 0,
+) -> torch.Tensor:
+    """Return one arena shared by native prefill and XQA/TRTLLM decode.
+
+    Attention execution is stream ordered: native prefill finishes using the
+    scratch region before decode starts using it. The XQA semaphore prefix is
+    kept private because XQA requires it to remain zero-initialized/persistent.
+    """
+    device = _canonical_cuda_device(device)
+    xqa_workspace_size = envs.VLLM_FLASHINFER_WORKSPACE_BUFFER_SIZE
+    if xqa_workspace_size < xqa_min_workspace_size:
+        raise ValueError(
+            "VLLM_FLASHINFER_WORKSPACE_BUFFER_SIZE is too small for the "
+            "configured FlashInfer 0.6.17 XQA shape envelope: "
+            f"configured {xqa_workspace_size / (1 << 20):.2f} MiB, "
+            f"minimum {xqa_min_workspace_size / (1 << 20):.2f} MiB"
+        )
+    required_size = max(
+        xqa_workspace_size,
+        FLASHINFER_XQA_SEMAPHORE_BUFFER_SIZE + native_workspace_size,
+    )
+    workspace_buffer = _flashinfer_shared_workspace_buffers.get(device)
+    if workspace_buffer is None or workspace_buffer.numel() < required_size:
+        old_size = workspace_buffer.numel() if workspace_buffer is not None else 0
+        workspace_buffer = torch.zeros(
+            required_size, dtype=torch.uint8, device=device
+        )
+        _flashinfer_shared_workspace_buffers[device] = workspace_buffer
+        for consumer in list(
+            _flashinfer_shared_workspace_consumers.get(device, ())
+        ):
+            consumer._reset_shared_workspace_buffer(workspace_buffer)
+        logger.info(
+            "FlashInfer shared attention workspace on %s: %.2f MiB "
+            "(was %.2f MiB, XQA configured %.2f MiB, "
+            "XQA minimum %.2f MiB, native prefill %.2f MiB)",
+            device,
+            required_size / (1 << 20),
+            old_size / (1 << 20),
+            xqa_workspace_size / (1 << 20),
+            xqa_min_workspace_size / (1 << 20),
+            native_workspace_size / (1 << 20),
+        )
+    return workspace_buffer
 
 
