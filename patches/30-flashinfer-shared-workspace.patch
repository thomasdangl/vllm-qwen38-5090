+            max_tokens - min_prefill_len * (max_reqs - 1),
+            *([min_prefill_len] * (max_reqs - 1)),
+        ]
+        query_patterns.update(((max_tokens,), tuple(balanced), tuple(skewed)))
+
+        max_float_workspace_size = 0
+        max_int_workspace_size = 0
+        max_seq_len = self.model_config.max_model_len
+        pages_per_req = cdiv(max_seq_len, self.page_size)
