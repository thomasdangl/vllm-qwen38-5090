+    def _presize_xqa_shared_workspace(self) -> None:
+        """Sample the native-prefill shape envelope, then share with XQA."""
+        assert not self.use_dcp
+        assert not self.has_sinks
+        wrapper = self._get_prefill_wrapper(causal=True)
+        assert isinstance(wrapper, BatchPrefillWithPagedKVCacheWrapper)
+
+        max_tokens = self.max_num_batched_tokens
+        min_prefill_len = min(
+            max_tokens, max(1, (self.reorder_batch_threshold or 0) + 1)
+        )
+        max_reqs = max(
+            1, min(self.max_num_reqs, max_tokens // min_prefill_len)
+        )
+        candidate_lens = {min_prefill_len, max_tokens}
+        power_of_two = 1
+        while power_of_two <= max_tokens:
+            for query_len in (
+                power_of_two - 1,
+                power_of_two,
+                power_of_two + 1,
+            ):
+                if min_prefill_len <= query_len <= max_tokens:
+                    candidate_lens.add(query_len)
+            power_of_two *= 2
+
+        query_patterns: set[tuple[int, ...]] = set()
+        for query_len in candidate_lens:
+            query_patterns.add((query_len,))
+            for num_reqs in range(2, max_reqs + 1):
+                if query_len * num_reqs <= max_tokens:
+                    query_patterns.add((query_len,) * num_reqs)
+                if query_len + min_prefill_len * (num_reqs - 1) <= max_tokens:
+                    query_patterns.add(
+                        (query_len,) + (min_prefill_len,) * (num_reqs - 1)
+                    )
+
+        balanced = [max_tokens // max_reqs] * max_reqs
+        balanced[-1] += max_tokens % max_reqs
