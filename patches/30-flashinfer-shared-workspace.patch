+def _register_shared_workspace_consumer(device: torch.device, consumer) -> None:
+    device = _canonical_cuda_device(device)
+    consumers = _flashinfer_shared_workspace_consumers.setdefault(device, WeakSet())
+    consumers.add(consumer)
+
