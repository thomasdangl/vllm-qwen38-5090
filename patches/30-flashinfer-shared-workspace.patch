+    def _get_xqa_min_workspace_size(self) -> int:
+        """Bound the generic XQA workspace layout shipped by FlashInfer 0.6.17."""
+        head_group_ratio = self.num_qo_heads // self.num_kv_heads
+        max_q_len = max(1, self.reorder_batch_threshold or 1)
+        max_seq_len = cdiv(
+            self.model_config.max_model_len, self.page_size
+        ) * self.page_size
+        sm_count = torch.cuda.get_device_properties(
+            _canonical_cuda_device(self.device)
+        ).multi_processor_count
+        max_scratch_size = 0
+
+        for batch_size in range(1, self.max_num_reqs + 1):
+            subseqs_per_group = min(
+                max(1, sm_count // (batch_size * self.num_kv_heads)),
+                cdiv(max_seq_len, FLASHINFER_XQA_CTA_TILE_SEQ_LEN),
+            )
+            for q_len in range(1, max_q_len + 1):
+                if q_len == 1:
+                    valid_rows = head_group_ratio
+                    token_blocks_per_group = 1
+                else:
+                    valid_rows = FLASHINFER_XQA_ROWS_PER_SPEC_BLOCK
+                    token_blocks_per_group = cdiv(
+                        q_len * head_group_ratio,
+                        FLASHINFER_XQA_ROWS_PER_SPEC_BLOCK,
+                    )
+
+                warp_tile_rows = cdiv(valid_rows, 16) * 16
+                row_stats_size = (
+                    cdiv(warp_tile_rows, 32)
+                    * FLASHINFER_XQA_ROW_STATS_BYTES_PER_WARP_TILE
+                )
+                partial_output_size = (
+                    valid_rows
+                    * self.head_dim
+                    * FLASHINFER_XQA_INPUT_ELEM_SIZE
+                )
+                num_subseqs = (
+                    subseqs_per_group
+                    * batch_size
+                    * self.num_kv_heads
+                    * token_blocks_per_group
+                )
+
+                row_stats_end = 2 * row_stats_size * num_subseqs
+                partials_begin = (
+                    cdiv(row_stats_end, partial_output_size)
+                    * partial_output_size
+                )
+                scratch_size = (
+                    partials_begin + partial_output_size * num_subseqs
+                )
+                max_scratch_size = max(max_scratch_size, scratch_size)
+
+        required_size = FLASHINFER_XQA_SEMAPHORE_BUFFER_SIZE + max_scratch_size
+        return cdiv(required_size, 1 << 20) * (1 << 20)
