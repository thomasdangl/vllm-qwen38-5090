--- /dev/null
+++ b/vllm/model_executor/models/vision_swap_vmm.cpp
@@ -0,0 +1,178 @@
+// SPDX-License-Identifier: Apache-2.0
+// CUDA VMM ownership independent of PyTorch's caching allocator. No kernels,
+// no libtorch ABI, and no physical allocation is owned by two allocators.
+#include <cuda.h>
+#include <dlfcn.h>
+#include <cstdint>
+#include <limits>
+#include <memory>
+#include <stdexcept>
+#include <string>
+
+namespace {
+thread_local std::string error;
+struct Driver {
+  void* library;
+#define ENTRY(name, symbol) decltype(&name) name##_fn
+  ENTRY(cuCtxGetCurrent, unused);
+  ENTRY(cuCtxPushCurrent, unused);
+  ENTRY(cuCtxPopCurrent, unused);
+  ENTRY(cuCtxSynchronize, unused);
+  ENTRY(cuMemGetAllocationGranularity, unused);
+  ENTRY(cuMemAddressReserve, unused);
+  ENTRY(cuMemAddressFree, unused);
+  ENTRY(cuMemCreate, unused);
+  ENTRY(cuMemMap, unused);
+  ENTRY(cuMemSetAccess, unused);
+  ENTRY(cuMemUnmap, unused);
+  ENTRY(cuMemRelease, unused);
+#undef ENTRY
+  Driver() {
+    library = dlopen("libcuda.so.1", RTLD_NOW | RTLD_LOCAL);
+    if (!library) throw std::runtime_error("Cannot load libcuda.so.1");
+#define LOAD(name, symbol) \
+    name##_fn = reinterpret_cast<decltype(name##_fn)>(dlsym(library, symbol)); \
+    if (!name##_fn) throw std::runtime_error("CUDA driver missing " symbol)
+    LOAD(cuCtxGetCurrent, "cuCtxGetCurrent");
+    LOAD(cuCtxPushCurrent, "cuCtxPushCurrent_v2");
+    LOAD(cuCtxPopCurrent, "cuCtxPopCurrent_v2");
+    LOAD(cuCtxSynchronize, "cuCtxSynchronize");
+    LOAD(cuMemGetAllocationGranularity, "cuMemGetAllocationGranularity");
+    LOAD(cuMemAddressReserve, "cuMemAddressReserve");
+    LOAD(cuMemAddressFree, "cuMemAddressFree");
+    LOAD(cuMemCreate, "cuMemCreate");
+    LOAD(cuMemMap, "cuMemMap");
+    LOAD(cuMemSetAccess, "cuMemSetAccess");
+    LOAD(cuMemUnmap, "cuMemUnmap");
+    LOAD(cuMemRelease, "cuMemRelease");
+#undef LOAD
+  }
+};
+Driver& driver() { static Driver* d = new Driver(); return *d; }
+void check(CUresult r, const char* operation) {
+  if (r != CUDA_SUCCESS)
+    throw std::runtime_error(std::string(operation) + " failed, CUDA error " + std::to_string(r));
+}
+struct Context {
+  explicit Context(CUcontext ctx) {
+    if (!ctx) throw std::runtime_error("Initialize PyTorch CUDA context before VMM allocation");
+    check(driver().cuCtxPushCurrent_fn(ctx), "cuCtxPushCurrent");
+  }
+  ~Context() { CUcontext old; driver().cuCtxPopCurrent_fn(&old); }
+};
+struct Allocation {
+  CUcontext context = nullptr;
+  CUdeviceptr address = 0;
+  CUmemGenericAllocationHandle handle = 0;
+  size_t bytes = 0;
+  int device = 0;
+  bool mapped = false;
+};
+CUmemAllocationProp properties(int device) {
+  CUmemAllocationProp p{};
+  p.type = CU_MEM_ALLOCATION_TYPE_PINNED;
+  p.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+  p.location.id = device;
+  return p;
+}
+size_t allocation_size(int device, size_t requested) {
+  auto prop = properties(device);
+  size_t granularity = 0;
+  check(driver().cuMemGetAllocationGranularity_fn(&granularity, &prop,
+        CU_MEM_ALLOC_GRANULARITY_MINIMUM), "cuMemGetAllocationGranularity");
+  if (!requested || requested > std::numeric_limits<size_t>::max() - granularity)
+    throw std::runtime_error("Invalid VMM allocation size");
+  return (requested + granularity - 1) / granularity * granularity;
+}
+void restore(Allocation& a) {
+  if (a.mapped || a.handle) throw std::runtime_error("VMM allocation is already resident");
+  auto& d = driver();
+  auto prop = properties(a.device);
+  check(d.cuMemCreate_fn(&a.handle, a.bytes, &prop, 0), "cuMemCreate");
+  try {
+    check(d.cuMemMap_fn(a.address, a.bytes, 0, a.handle, 0), "cuMemMap");
+    a.mapped = true;
+    CUmemAccessDesc access{};
+    access.location = prop.location;
+    access.flags = CU_MEM_ACCESS_FLAGS_PROT_READWRITE;
+    check(d.cuMemSetAccess_fn(a.address, a.bytes, &access, 1), "cuMemSetAccess");
+  } catch (...) {
+    if (a.mapped) {
+      check(d.cuMemUnmap_fn(a.address, a.bytes), "cuMemUnmap after map failure");
+      a.mapped = false;
+    }
+    check(d.cuMemRelease_fn(a.handle), "cuMemRelease after map failure");
+    a.handle = 0;
+    throw;
+  }
+}
+void evict(Allocation& a) {
+  if (!a.mapped) throw std::runtime_error("VMM allocation is already evicted");
+  auto& d = driver();
+  check(d.cuCtxSynchronize_fn(), "cuCtxSynchronize");
+  check(d.cuMemUnmap_fn(a.address, a.bytes), "cuMemUnmap");
+  a.mapped = false;
+  check(d.cuMemRelease_fn(a.handle), "cuMemRelease");
+  a.handle = 0;
+}
+void release(Allocation& a) {
+  auto& d = driver();
+  if (a.mapped) evict(a);
+  if (a.handle) {
+    check(d.cuMemRelease_fn(a.handle), "cuMemRelease");
+    a.handle = 0;
+  }
+  if (a.address) {
+    check(d.cuMemAddressFree_fn(a.address, a.bytes), "cuMemAddressFree");
+    a.address = 0;
+  }
+}
+template <class F> int run(F fn) {
+  try { fn(); error.clear(); return 0; }
+  catch (const std::exception& e) { error = e.what(); return -1; }
+  catch (...) { error = "Unknown VMM error"; return -1; }
+}
+}  // namespace
+
+extern "C" {
+int vs_abi_version() { return 1; }
+const char* vs_last_error() { return error.c_str(); }
+int vs_allocation_size(int device, size_t requested, size_t* result) {
+  return run([&] { *result = allocation_size(device, requested); });
+}
+int vs_allocate(int device, size_t requested, void** result) {
+  *result = nullptr;
+  return run([&] {
+    auto a = std::make_unique<Allocation>();
+    a->device = device;
+    auto& d = driver();
+    check(d.cuCtxGetCurrent_fn(&a->context), "cuCtxGetCurrent");
+    Context ctx(a->context);
+    const size_t granularity = allocation_size(device, 1);
+    a->bytes = allocation_size(device, requested);
+    check(d.cuMemAddressReserve_fn(&a->address, a->bytes, granularity, 0, 0),
+          "cuMemAddressReserve");
+    try { restore(*a); }
+    catch (...) { release(*a); throw; }
+    *result = a.release();
+  });
+}
+int vs_evict(void* ptr) {
+  return run([&] { auto& a = *static_cast<Allocation*>(ptr); Context ctx(a.context); evict(a); });
+}
+int vs_restore(void* ptr) {
+  return run([&] { auto& a = *static_cast<Allocation*>(ptr); Context ctx(a.context); restore(a); });
+}
+int vs_free(void* ptr) {
+  if (!ptr) return 0;
+  return run([&] {
+    auto* a = static_cast<Allocation*>(ptr);
+    Context ctx(a->context);
+    release(*a);
+    delete a;
+  });
+}
+uint64_t vs_address(void* ptr) { return static_cast<Allocation*>(ptr)->address; }
+size_t vs_bytes(void* ptr) { return static_cast<Allocation*>(ptr)->bytes; }
+int vs_resident(void* ptr) { return static_cast<Allocation*>(ptr)->mapped; }
+}
