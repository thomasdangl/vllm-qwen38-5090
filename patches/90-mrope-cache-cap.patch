+def _resolve_mrope_cache_size(max_position_embeddings: int) -> tuple[int, str]:
+    """Return a lossless MRoPE cache bound for the configured modalities.
+
+    Text and image MRoPE indices are bounded by sequence length. Video temporal
+    indices can exceed it, so preserve vLLM's conservative 4x allocation unless
+    video inputs are provably disabled. Precomputed multimodal embeddings can
+    bypass zero modality limits and therefore also require the conservative
+    allocation.
+    """
+    upstream_size = max_position_embeddings * 4
+    if not envs.VLLM_MROPE_CACHE_CAP:
+        return upstream_size, "optimization disabled"
+
+    vllm_config = get_current_vllm_config()
+    model_config = vllm_config.model_config
+    mm_config = model_config.multimodal_config
+
+    if mm_config is not None and mm_config.enable_mm_embeds:
+        return upstream_size, "precomputed multimodal embeddings enabled"
+
+    if mm_config is None or mm_config.language_model_only:
+        reason = "language-model-only"
+    elif mm_config.get_limit_per_prompt("video") == 0:
+        reason = "video limit is zero"
+    else:
+        return upstream_size, "video inputs enabled or not explicitly disabled"
+
+    # For text and images, every MRoPE T/H/W index is smaller than the number
+    # of sequence tokens represented so far. max_model_len is therefore the
+    # exact runtime upper bound (positions are zero based).
+    return min(upstream_size, model_config.max_model_len), reason
 
 
